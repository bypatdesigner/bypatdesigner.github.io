<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%" style="background:#FFFFFF;">
  <rect width="1200" height="800" fill="#FFFFFF"/>
  <rect x="40" y="40" width="1120" height="720" fill="none" stroke="rgba(31,21,23,0.1)" rx="12"/>

  <!-- Header -->
  <text x="80" y="95" font-family="monospace" font-size="13" font-weight="700" letter-spacing="3" fill="#9B1B22">MANUALE D'USO · SPECIMEN TIPOGRAFICO UFFICIALE</text>
  <text x="80" y="155" font-family="'Montserrat', 'Cabinet Grotesk', system-ui, sans-serif" font-weight="900" font-size="56" letter-spacing="-1.5" fill="#141416">Sequel Sans</text>
  <text x="480" y="148" font-family="'Satoshi', system-ui, sans-serif" font-weight="500" font-size="16" fill="#736467">Post Max Bill 2017 · Oliver Jeschke</text>

  <line x1="80" y1="185" x2="1120" y2="185" stroke="rgba(31,21,23,0.1)" stroke-width="1"/>

  <!-- Big Alphabet Stream -->
  <g transform="translate(80, 240)">
    <text x="0" y="0" font-family="'Montserrat', system-ui, sans-serif" font-weight="700" font-size="28" letter-spacing="3" fill="#141416">ABCDEFGHIJKLMNOPQRSTUVWXYZ</text>
    <text x="0" y="44" font-family="'Montserrat', system-ui, sans-serif" font-weight="400" font-size="28" letter-spacing="3" fill="#493A3E">abcdefghijklmnopqrstuvwxyz</text>
    <text x="0" y="88" font-family="'Montserrat', system-ui, sans-serif" font-weight="600" font-size="28" letter-spacing="4" fill="#9B1B22">0123456789 &amp; @ € $ £ # % * ! ?</text>
  </g>

  <!-- Weight Hierarchy Grid -->
  <g transform="translate(80, 410)">
    <!-- Column 1: BodyText -->
    <rect x="0" y="0" width="320" height="290" rx="8" fill="#FBF9F5" stroke="rgba(31,21,23,0.08)"/>
    <text x="24" y="36" font-family="monospace" font-size="12" font-weight="700" fill="#9B1B22">COLLEZIONE 01</text>
    <text x="24" y="68" font-family="'Montserrat', system-ui, sans-serif" font-weight="800" font-size="24" fill="#141416">BodyText</text>
    <text x="24" y="100" font-family="'Montserrat', system-ui, sans-serif" font-weight="300" font-size="16" fill="#493A3E">Light 300 · Leggibilità pura</text>
    <text x="24" y="130" font-family="'Montserrat', system-ui, sans-serif" font-weight="400" font-size="16" fill="#493A3E">Book 400 · Testi editoriali</text>
    <text x="24" y="160" font-family="'Montserrat', system-ui, sans-serif" font-weight="500" font-size="16" fill="#141416">Roman 500 · Cartelle stampa</text>
    <text x="24" y="190" font-family="'Montserrat', system-ui, sans-serif" font-weight="600" font-size="16" fill="#141416">Medium 600 · Didattica</text>
    <text x="24" y="220" font-family="'Montserrat', system-ui, sans-serif" font-weight="700" font-size="16" fill="#141416">Semi Bold 700 · Didascalie</text>
    <text x="24" y="250" font-family="'Montserrat', system-ui, sans-serif" font-weight="800" font-size="16" fill="#141416">Bold 800 · Enfasi</text>

    <!-- Column 2: Headline -->
    <rect x="360" y="0" width="320" height="290" rx="8" fill="#FBF9F5" stroke="rgba(31,21,23,0.08)"/>
    <text x="384" y="36" font-family="monospace" font-size="12" font-weight="700" fill="#9B1B22">COLLEZIONE 02</text>
    <text x="384" y="68" font-family="'Montserrat', system-ui, sans-serif" font-weight="800" font-size="24" fill="#141416">Headline</text>
    <text x="384" y="105" font-family="'Montserrat', system-ui, sans-serif" font-weight="600" font-size="18" fill="#141416">Architettura del Suono</text>
    <text x="384" y="145" font-family="'Montserrat', system-ui, sans-serif" font-weight="700" font-size="20" fill="#141416">Stagione Lirica 2020</text>
    <text x="384" y="190" font-family="'Montserrat', system-ui, sans-serif" font-weight="800" font-size="22" fill="#141416">Grande Musica a Bari</text>
    <text x="384" y="245" font-family="'Montserrat', system-ui, sans-serif" font-weight="900" font-size="24" letter-spacing="-0.5" fill="#9B1B22">Teatro Petruzzelli</text>

    <!-- Column 3: Display & Rationals -->
    <rect x="720" y="0" width="320" height="290" rx="8" fill="#FBF9F5" stroke="rgba(31,21,23,0.08)"/>
    <text x="744" y="36" font-family="monospace" font-size="12" font-weight="700" fill="#9B1B22">RAZIONALE PROGETTUALE</text>
    <text x="744" y="68" font-family="'Montserrat', system-ui, sans-serif" font-weight="800" font-size="24" fill="#141416">Display &amp; Sintesi</text>
    <text x="744" y="105" font-family="'Satoshi', system-ui, sans-serif" font-size="13.5" line-height="1.6" fill="#493A3E">
      I caratteri sans-serif senza grazie garantiscono stabilità, modernità e sobrietà formale. Risolvono con assoluta precisione la leggibilità sia su affissione monumentale che su display digitali e cartoleria istituzionale.
    </text>
    <text x="744" y="225" font-family="monospace" font-size="11" font-weight="700" fill="#D4A017">PESI UFFICIALI MARCHIO:</text>
    <text x="744" y="250" font-family="'Montserrat', system-ui, sans-serif" font-size="14" font-weight="700" fill="#141416">Teatro (Roman) · Petruzzelli (Bold)</text>
  </g>
</svg>